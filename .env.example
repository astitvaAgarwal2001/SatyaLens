# ==========================================
# SatyaLens Environment Configuration
# ==========================================

# 1. AI Engine (Google Gemini API - Free Tier Key)
# Get your free key at: https://aistudio.google.com/app/apikey
# If left empty, SatyaLens will seamlessly use built-in heuristic analysis fallbacks!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Authentication & JWT Security
JWT_SECRET=super_secret_jwt_key_satyalens_change_in_production_2025
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Database Persistence (PostgreSQL or SQLite)
# For local SQLite: sqlite:///./satyalens.db
# For Supabase / Render Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./satyalens.db

# 4. Redis Cache (Optional - automatic in-memory fallback if unset)
REDIS_URL=redis://localhost:6379/0

# 5. Frontend API Target & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
