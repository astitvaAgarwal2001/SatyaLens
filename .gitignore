# ==========================================
# SatyaLens Git Ignore Rules
# ==========================================

# 1. Environment Variables & API Secrets (NEVER COMMIT)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example

# Secret keys, credentials & certificates
*.pem
*.key
*.cert
*.crt
secrets.json
service-account*.json
credentials*.json

# 2. Python & Virtual Environments
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
.venv/
env/
ENV/
.pytest_cache/

# 3. Database Files (SQLite / Local persistence)
*.db
*.sqlite
*.sqlite3
satyalens.db
backend/satyalens.db

# 4. Node & Next.js dependencies / build cache
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
next-env.d.ts
.yarn/
.pnp
.pnp.js

# 5. Logs & debug outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
